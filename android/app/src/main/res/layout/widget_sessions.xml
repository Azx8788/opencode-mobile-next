<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4 and taller: the conversations list. Also the layout shown before the first update. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="locale" android:background="@drawable/widget_card_bg"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical">
        <TextView android:id="@+id/wc_head_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_label_short" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
            android:textColor="@color/widgetHint" />
        <TextView android:id="@+id/wc_head_need" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
        <TextView android:id="@+id/wc_head_work" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wc_rows" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" />
    <LinearLayout android:id="@+id/wc_new" android:layout_width="match_parent" android:layout_height="32dp"
        android:layout_marginTop="6dp" android:gravity="center_vertical" android:background="@drawable/widget_pill">
        <TextView android:id="@+id/wc_new_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:paddingStart="14dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
            android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetHint" />
        <FrameLayout android:id="@+id/wc_mic" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="@drawable/widget_pill">
            <ImageView android:id="@+id/wc_mic_icon" android:layout_width="14dp" android:layout_height="14dp"
                android:layout_gravity="center" android:src="@drawable/ic_widget_mic" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
