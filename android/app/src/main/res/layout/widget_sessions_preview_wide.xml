<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview: sample content in the live look; no data, no actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_card_bg" android:layoutDirection="locale"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="7dp" android:src="@drawable/widget_preview_dot_amber" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_preview_status_needs" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widgetAmber" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/widget_preview_question" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widgetText" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/widget_preview_command" android:fontFamily="monospace" android:textSize="13sp" android:textColor="@color/widgetText" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/widget_preview_from" android:textSize="12sp" android:textColor="@color/widgetHint" android:maxLines="1" android:ellipsize="end" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginStart="-3dp" android:layout_marginEnd="-3dp" android:layout_marginTop="8dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:text="@string/widget_v2_reject" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widgetText" android:maxLines="1" android:background="@drawable/widget_preview_pill_soft" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:text="@string/widget_v2_open" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widgetText" android:maxLines="1" android:background="@drawable/widget_preview_pill_soft" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:text="@string/widget_v2_allow" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widgetCard" android:maxLines="1" android:background="@drawable/widget_preview_pill_ink" />
    </LinearLayout>
</LinearLayout>
