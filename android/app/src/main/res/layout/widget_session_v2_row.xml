<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wc_page" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="locale"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/wc_dot" android:layout_width="8dp" android:layout_height="8dp"
            android:layout_marginEnd="7dp" android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
        <TextView android:id="@+id/wc_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
            android:textDirection="firstStrong" />
        <TextView android:id="@+id/wc_project" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
            android:textDirection="firstStrong" />
    </LinearLayout>
    <FrameLayout android:id="@+id/wc_gap_top" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:visibility="gone" />
    <TextView android:id="@+id/wc_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="16sp" android:textStyle="bold" android:lineHeight="21sp"
        android:maxLines="3" android:ellipsize="end" android:textDirection="firstStrong" android:gravity="start"
        android:textColor="@color/widgetText" />
    <TextView android:id="@+id/wc_q" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="14sp" android:textStyle="bold" android:lineHeight="19sp"
        android:maxLines="2" android:ellipsize="end" android:textDirection="firstStrong" android:gravity="start"
        android:textColor="@color/widgetText" android:visibility="gone" />
    <TextView android:id="@+id/wc_file" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:fontFamily="monospace" android:textSize="13sp" android:lineHeight="16sp"
        android:maxLines="2" android:ellipsize="end" android:textDirection="ltr" android:gravity="start"
        android:textColor="@color/widgetText" android:visibility="gone" />
    <TextView android:id="@+id/wc_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="12sp" android:lineHeight="16sp" android:maxLines="2"
        android:ellipsize="end" android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetHint" />
    <TextView android:id="@+id/wc_d2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="12sp" android:lineHeight="16sp" android:maxLines="2"
        android:ellipsize="end" android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetHint"
        android:visibility="gone" />
    <TextView android:id="@+id/wc_d3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="12sp" android:lineHeight="16sp" android:maxLines="2"
        android:ellipsize="end" android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetHint"
        android:visibility="gone" />
    <Chronometer android:id="@+id/wc_live" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="12sp" android:lineHeight="16sp" android:maxLines="2"
        android:ellipsize="end" android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetHint"
        android:visibility="gone" />
    <TextView android:id="@+id/wc_preview" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="13sp" android:lineHeight="18sp" android:maxLines="4"
        android:ellipsize="end" android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetText"
        android:visibility="gone" />
    <FrameLayout android:id="@+id/wc_gap_bottom" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/wc_ask" android:layout_width="match_parent" android:layout_height="36dp"
        android:gravity="center_vertical" android:background="@drawable/widget_pill">
        <TextView android:id="@+id/wc_ask_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:paddingStart="14dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
            android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetHint" />
        <FrameLayout android:id="@+id/wc_mic" android:layout_width="26dp" android:layout_height="26dp"
            android:layout_marginEnd="5dp" android:layout_marginStart="4dp" android:background="@drawable/widget_pill">
            <ImageView android:id="@+id/wc_mic_icon" android:layout_width="14dp" android:layout_height="14dp"
                android:layout_gravity="center" android:src="@drawable/ic_widget_mic" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/wc_buttons" android:layout_width="match_parent" android:layout_height="34dp"
        android:layout_marginStart="-3dp" android:layout_marginEnd="-3dp" android:layout_marginTop="8dp" android:visibility="gone">
        <TextView android:id="@+id/wc_btn1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:textSize="13sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:background="@drawable/widget_pill" />
        <TextView android:id="@+id/wc_btn2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:textSize="13sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:background="@drawable/widget_pill" />
        <TextView android:id="@+id/wc_btn3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:textSize="13sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:background="@drawable/widget_pill" />
    </LinearLayout>
</LinearLayout>
