<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wc_row"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:orientation="vertical" android:layoutDirection="locale">
    <FrameLayout android:id="@+id/wc_divider" android:layout_width="match_parent" android:layout_height="1dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:id="@+id/wc_dot" android:layout_width="8dp" android:layout_height="8dp"
                    android:layout_marginEnd="10dp" android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
                <TextView android:id="@+id/wc_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
                    android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetText" />
            </LinearLayout>
            <TextView android:id="@+id/wc_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="18dp" android:layout_marginTop="2dp" android:textSize="12sp" android:maxLines="1"
                android:ellipsize="end" android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetHint" />
            <Chronometer android:id="@+id/wc_live" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="18dp" android:layout_marginTop="2dp" android:textSize="12sp" android:maxLines="1"
                android:ellipsize="end" android:textDirection="firstStrong" android:gravity="start" android:textColor="@color/widgetHint"
                android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/wc_btn2" android:layout_width="wrap_content" android:layout_height="30dp"
            android:minWidth="56dp" android:layout_marginStart="8dp" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
            android:background="@drawable/widget_pill" android:visibility="gone" />
        <TextView android:id="@+id/wc_btn1" android:layout_width="wrap_content" android:layout_height="30dp"
            android:minWidth="64dp" android:layout_marginStart="8dp" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
            android:background="@drawable/widget_pill" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
