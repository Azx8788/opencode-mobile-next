<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview: sample content in the live look; no data, no actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/widget_card_bg" android:layoutDirection="locale"
    android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp">
    <ImageView android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="12dp" android:src="@drawable/widget_preview_dot_green" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_strip_title" android:textSize="15sp" android:textColor="@color/widgetText" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:gravity="start" android:textDirection="firstStrong" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_strip_status" android:textSize="12sp" android:textColor="@color/widgetHint" android:maxLines="1" android:ellipsize="end" android:gravity="start" android:textDirection="firstStrong" />
    </LinearLayout>
    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="10dp" android:background="@drawable/widget_preview_pill_green"><ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/ic_widget_mic_card" android:importantForAccessibility="no" /></FrameLayout>
</LinearLayout>
