<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview: sample content in the live look; no data, no actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_card_bg" android:layoutDirection="locale"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="7dp" android:src="@drawable/widget_preview_dot_green" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_preview_status_ready" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widgetHint" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/widget_preview_ready_title" android:textSize="16sp" android:textStyle="bold" android:lineHeight="21sp" android:maxLines="3" android:ellipsize="end" android:textColor="@color/widgetText" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/widget_preview_ready_when" android:textSize="12sp" android:textColor="@color/widgetHint" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:background="@drawable/widget_preview_pill_soft">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="14dp" android:text="@string/widget_v2_ask_followup" android:textSize="13sp" android:textColor="@color/widgetHint" android:maxLines="1" android:ellipsize="end" />
        <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="5dp" android:background="@drawable/widget_preview_pill_green"><ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="center" android:src="@drawable/ic_widget_mic_card" android:importantForAccessibility="no" /></FrameLayout>
    </LinearLayout>
</LinearLayout>
